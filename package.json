{
  "name": "python-inline-values",
  "displayName": "Evalens \u2014 Inline Python Values",
  "description": "See values inline as you type. No print(), no debugger, no notebook.",
  "version": "0.0.1",
  "publisher": "mbjarland",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mbjarland/evalens.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "python",
    "repl",
    "inline",
    "live",
    "values",
    "evaluate",
    "calva",
    "nrepl",
    "arepl",
    "print debugging"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "evalens.evaluateFile",
        "title": "Evalens: Evaluate File"
      },
      {
        "command": "evalens.evaluateAtCursor",
        "title": "Evalens: Evaluate at Cursor"
      },
      {
        "command": "evalens.restartKernel",
        "title": "Evalens: Restart Kernel"
      },
      {
        "command": "evalens.clearResults",
        "title": "Evalens: Clear Inline Results"
      }
    ],
    "configuration": {
      "title": "Evalens",
      "properties": {
        "evalens.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Interpreter used to run the evaluation kernel. Empty means use the interpreter selected by the Python extension, falling back to `python3`."
        },
        "evalens.alignColumn": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "markdownDescription": "Column to align inline results to. A line already past this column gets a small gap instead, so one long statement cannot drag every other result off the screen. `0` disables alignment."
        }
      }
    },
    "colors": [
      {
        "id": "evalens.resultForeground",
        "description": "Colour of an inline evaluation result.",
        "defaults": {
          "dark": "#d1a35c",
          "light": "#8a6a2b",
          "highContrast": "#f0c674",
          "highContrastLight": "#6b4a10"
        }
      },
      {
        "id": "evalens.resultBackground",
        "description": "Background behind an inline evaluation result. Transparent by default; set a colour here to give results a chip.",
        "defaults": {
          "dark": "#00000000",
          "light": "#00000000",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "evalens.errorForeground",
        "description": "Colour of an inline evaluation error.",
        "defaults": {
          "dark": "#f14c4c",
          "light": "#c62828",
          "highContrast": "#f48771",
          "highContrastLight": "#a01818"
        }
      },
      {
        "id": "evalens.errorBackground",
        "description": "Background behind an inline evaluation error. Transparent by default.",
        "defaults": {
          "dark": "#00000000",
          "light": "#00000000",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "evalens.evaluatedRegionBackground",
        "description": "Background of the region an evaluation covered.",
        "defaults": {
          "dark": "#4a9c8c22",
          "light": "#2a7d6d1a",
          "highContrast": "#4a9c8c44",
          "highContrastLight": "#2a7d6d33"
        }
      }
    ],
    "keybindings": [
      {
        "command": "evalens.evaluateFile",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == python && !findWidgetVisible"
      },
      {
        "command": "evalens.evaluateAtCursor",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == python && !findWidgetVisible"
      },
      {
        "command": "evalens.clearResults",
        "key": "escape",
        "when": "editorTextFocus && evalens.hasAnnotations"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "pretest": "npm run compile",
    "test": "node --test out/test/",
    "test:kernel": "python3 -m unittest discover -s kernel -t kernel"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.9.3"
  }
}
