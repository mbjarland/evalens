{
  "name": "python-inline-values",
  "displayName": "Evalens \u2014 Inline Python Values",
  "description": "See values inline as you type. No print(), no debugger, no notebook.",
  "version": "0.0.1",
  "publisher": "mbjarland",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mbjarland/evalens.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "python",
    "repl",
    "inline",
    "live",
    "values",
    "evaluate",
    "calva",
    "nrepl",
    "arepl",
    "print debugging"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "evalens.evaluateAtCursor",
        "title": "Evalens: Evaluate at Cursor"
      },
      {
        "command": "evalens.restartKernel",
        "title": "Evalens: Restart Kernel"
      },
      {
        "command": "evalens.clearResults",
        "title": "Evalens: Clear Inline Results"
      }
    ],
    "configuration": {
      "title": "Evalens",
      "properties": {
        "evalens.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Interpreter used to run the evaluation kernel. Empty means use the interpreter selected by the Python extension, falling back to `python3`."
        }
      }
    },
    "colors": [
      {
        "id": "evalens.resultForeground",
        "description": "Colour of an inline evaluation result.",
        "defaults": {
          "dark": "editorCodeLens.foreground",
          "light": "editorCodeLens.foreground",
          "highContrast": "editorCodeLens.foreground",
          "highContrastLight": "editorCodeLens.foreground"
        }
      },
      {
        "id": "evalens.errorForeground",
        "description": "Colour of an inline evaluation error.",
        "defaults": {
          "dark": "errorForeground",
          "light": "errorForeground",
          "highContrast": "errorForeground",
          "highContrastLight": "errorForeground"
        }
      },
      {
        "id": "evalens.evaluatedRegionBackground",
        "description": "Background of the region an evaluation covered.",
        "defaults": {
          "dark": "#4a9c8c22",
          "light": "#2a7d6d1a",
          "highContrast": "#4a9c8c44",
          "highContrastLight": "#2a7d6d33"
        }
      }
    ],
    "keybindings": [
      {
        "command": "evalens.clearResults",
        "key": "escape",
        "when": "editorTextFocus && evalens.hasAnnotations"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "pretest": "npm run compile",
    "test": "node --test out/test/",
    "test:kernel": "python3 -m unittest discover -s kernel -t kernel"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.9.3"
  }
}
